{
  "name": "chess-trainer",
  "productName": "Chess Trainer",
  "version": "0.1.0",
  "description": "A modern desktop chess training app: bullet drills today, master games and engine analysis tomorrow.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --mac --dir",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "test:e2e": "node scripts/e2e-electron.mjs && node scripts/e2e-openings.mjs && node scripts/e2e-memory.mjs && node scripts/e2e-visualisation.mjs",
    "fetch:stockfish": "node scripts/fetch-stockfish.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "chess.js": "^1.2.0",
    "chessground": "^9.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.arthur.chesstrainer",
    "productName": "Chess Trainer",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "stockfish",
        "to": "stockfish",
        "filter": [
          "stockfish-*",
          "Copying.txt"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dir"
      ]
    }
  }
}
